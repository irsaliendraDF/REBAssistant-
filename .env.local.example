# REB Assistant environment variables.
#
# Copy to .env.local and fill in. This file documents what is needed and holds no
# values. .env.local is gitignored and must stay that way.
#
# Nothing here is required to run the app locally right now. The hosted accounts
# are connected later in the build, and the app reports what is missing rather
# than failing at startup.

# ---------------------------------------------------------------------------
# Supabase (week 3 hosted switch)
# ---------------------------------------------------------------------------
# PROVISION THE PROJECT IN A CANADIAN REGION. Region is set once at project
# creation and cannot be changed afterwards without a full migration. Section 11
# of the signed agreement commits to Canadian-resident hosting. Getting this
# wrong is a rebuild, not a settings change.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server side only. Bypasses row level security. Never commit it, never expose it
# to the browser, never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Anthropic (week 3)
# ---------------------------------------------------------------------------
# Server side only. Every call passes through lib/anthropic/redaction.ts first.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Embeddings, for knowledge base search
# ---------------------------------------------------------------------------
# Anthropic does not provide an embeddings endpoint, so this is a separate
# provider. The vector dimension is fixed at 1024 in the migration and in
# lib/kb/config.ts; changing model means changing both and re-ingesting.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Placeholder sign-in for the local phase. Set to false once Supabase auth is
# configured. Must be false in any deployed environment.
NEXT_PUBLIC_USE_PLACEHOLDER_AUTH=true
